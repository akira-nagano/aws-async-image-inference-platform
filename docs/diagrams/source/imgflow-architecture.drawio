                <mxCell id="step-13" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" parent="1" vertex="1">
                    <mxGeometry x="780" y="360" width="28" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="step-14" value="14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" parent="1" vertex="1">
                    <mxGeometry x="720" y="1050" width="28" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=#6c8ebf;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2060" y="30" width="710" height="1250" as="geometry"/>
                </mxCell>
                <mxCell id="legend-title" value="Processing flow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#007CBD;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2090" y="50" width="650" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend-container" value="" style="group;fontFamily=Helvetica;" parent="1" connectable="0" vertex="1">
                    <mxGeometry x="2090" y="85" width="650" height="1165" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-1-text" value="&lt;b&gt;Web UIを開く&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;利用者がCloudFrontへHTTPSアクセスします。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="68" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-2-text" value="&lt;b&gt;SPA配信&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFrontがOAC経由で非公開S3オリジンを配信します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="68" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="136" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-3-text" value="&lt;b&gt;Managed login&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Cognitoが登録・メール確認・OAuthコードフローを担当し、登録後はtier-basicへ割り当てます。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="136" width="595" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="204" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-4-text" value="&lt;b&gt;認証済みAPI&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;/api/* をHTTP APIへ転送し、Cognito JWTを検証します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="204" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="272" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-5-text" value="&lt;b&gt;API Lambda実行&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;upload-url、job-submit、job-statusが所有者とTierを検査します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="272" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="340" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-6-text" value="&lt;b&gt;S3へ直接アップロード&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;署名付きPOSTで最大5 MiBの画像をAPI Gatewayを経由せず保存します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="340" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="408" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-7-text" value="&lt;b&gt;ジョブと枠を原子確保&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;JobsとConcurrencyをTransactWriteItemsで更新し、Tier超過は429、全体超過は503を返します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="408" width="595" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-8-badge" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="476" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-8-text" value="&lt;b&gt;Stream dispatch&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;JobsテーブルのNEW_IMAGEストリームがDispatcher Lambdaを起動します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="476" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-9-badge" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="544" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-9-text" value="&lt;b&gt;Workflow開始 / 起動拒否&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;jobIdでStandard実行を開始し、未作成が確定する拒否だけをFAILEDへ即時終端化します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="544" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-10-badge" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="612" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-10-text" value="&lt;b&gt;RUNNINGへ遷移&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;MarkRunning Lambdaが状態とリース期限を更新します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="612" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-11-badge" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="680" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-11-text" value="&lt;b&gt;Catalog推論&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;コンテナLambdaが入力S3を読み、DINOv2商品カタログ照合を実行します（3008 MB、900秒）。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="680" width="595" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-12-badge" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="748" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-12-text" value="&lt;b&gt;完了処理と枠解放&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;成功・失敗・タイムアウトを終端化し、slotState=HELDの条件付き更新で冪等に解放します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="748" width="595" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-13-badge" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="816" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-13-text" value="&lt;b&gt;状態ポーリング&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Web UIがGET /api/jobs/{jobId}で所有者のジョブ状態と結果を取得します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="816" width="595" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-14-badge" value="14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-container" vertex="1">
                    <mxGeometry y="884" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="legend-step-14-text" value="&lt;b&gt;期限切れリース回収&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;EventBridgeが5分ごとにReaperを起動し、再試行後も残った不明状態だけを最後の安全網として回収します。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry x="52" y="884" width="595" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="legend-aux-note" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;補助: CloudWatchログ、2カスタムメトリクス、4 Alarm、ダッシュボード、SNS Topic通知、S3アクセスログ。SQSキュー / DLQとVPC / WAFは現行スタックに含まれません。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry y="972" width="645" height="78" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
